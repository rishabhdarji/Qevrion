{
  "expo": {
    "name": "Qevrion",
    "slug": "qevrion",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "qevrion",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
