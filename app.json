{
  "expo": {
    "name": "Qevrion",
    "slug": "qevrion",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "qevrion",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qevrion uses your location while the app is open, to show your walking route to an event and how long it takes.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
